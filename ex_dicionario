# ==========================================
# Exercício 5: Contagem de Itens Repetidos
# ==========================================
lista = ["maçã", "banana", "laranja", "maçã", "banana", "maçã"]
frequencia = {}

for fruta in lista:
    if fruta in frequencia:
        frequencia[fruta] += 1
    else:
        frequencia[fruta] = 1

print("=== Exercício 5 ===")
print(f"Frequência: {frequencia}\n")


# ==========================================
# Exercício 6: Filtrando Dicionário
# ==========================================
produtos = {"caneta": 10, "mochila": 80, "caderno": 45, "notebook": 3000}

# Usando dictionary comprehension para filtrar
produtos_filtrados = {item: preco for item, preco in produtos.items() if preco > 50.00}

print("=== Exercício 6 ===")
print(f"Produtos acima de R$50: {produtos_filtrados}\n")



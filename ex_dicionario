# ==========================================
# Exercício 3: Iterando sobre um Dicionário
# ==========================================
notas = {
    "Alice": 8.5,
    "Bruno": 7.0,
    "Carla": 9.2,
    "Daniel": 6.8
}

print("=== Exercício 3 ===")
soma = 0
# 1. Itere sobre o dicionário
for nome, nota in notas.items():
    print(f"Aluno: {nome} - Nota: {nota}")
    soma += nota

# 2. Calcule a média
media = soma / len(notas)
print(f"Média da turma: {media:.2f}\n")



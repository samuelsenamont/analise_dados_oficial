# ==========================================
# Exercício 9: Dicionário Aninhado
# ==========================================
turma = {
    "Ana": {"idade": 17, "notas": [8, 9, 7]},
    "Pedro": {"idade": 18, "notas": [6, 7, 8]},
    "Mariana": {"idade": 17, "notas": [9, 10, 8]}
}

print("=== Exercício 9 ===")
# 1. Adicionar um novo aluno
turma["Lucas"] = {"idade": 19, "notas": [7, 8, 9]}

maior_media = 0
melhor_aluno = ""

# 2. Calcular a média de cada aluno
for aluno, dados in turma.items():
    notas_aluno = dados["notas"]
    media_aluno = sum(notas_aluno) / len(notas_aluno)
    print(f"{aluno}: Média {media_aluno:.1f}")
    
    # 3. Encontrar o aluno com a maior média
    if media_aluno > maior_media:
        maior_media = media_aluno
        melhor_aluno = aluno

print(f"Aluno com a maior média: {melhor_aluno}\n")



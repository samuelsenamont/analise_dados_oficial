# 21. Crie uma lista nomes...
nomes = ["Ana", "Pedro", "Maria", "João"]

# 22. Utilize um loop for para imprimir cada nome da lista.
print("\nNomes na lista:")
for nome in nomes:
    print(nome)

# 23. Crie uma nova lista nomes_maiusculos...
nomes_maiusculos = []
for nome in nomes:
    nomes_maiusculos.append(nome.upper())
print("Nomes maiúsculos:", nomes_maiusculos)

# 24. Crie uma lista numeros contendo os números de 1 a 20... pares.
numeros_20 = list(range(1, 21))
print("Números pares de 1 a 20:")
for num in numeros_20:
    if num % 2 == 0:
        print(num)

# 25. Usando a lista numeros, utilize um loop for para criar uma nova lista quadrados...
quadrados = []
for num in numeros_20:
    quadrados.append(num ** 2)
print("Quadrados:", quadrados)

